# RepoPilot — Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real configuration.

# PostgreSQL connection string with pgvector support
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/repopilot

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# GitHub Personal Access Token (optional, raises rate limit from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here

# Code Chunking Configuration
CHUNK_SIZE_TOKENS=250
CHUNK_OVERLAP_TOKENS=40
MAX_FILE_SIZE_KB=100
# Chunking strategy: 'ast' (Tree-sitter AST-aware chunking) or 'tokens' (sliding token window)
CHUNK_STRATEGY=ast

# Google Gemini API Key (cloud LLM fallback for codebase Q&A)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Configured daily request quota for your Gemini API tier (required for quota-reset eval scripts; set to your actual RPD limit)
GEMINI_DAILY_CALL_LIMIT=

# Groq Cloud API Configuration (OpenAI-compatible high-speed inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama Configuration (OpenAI-compatible endpoint at http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Provider Chains (comma-separated list of providers tried in order)
# Supported providers: gemini, groq, ollama
JUDGE_CHAIN=gemini,groq,ollama
GENERATOR_CHAIN=gemini,groq,ollama
AUX_CHAIN=gemini,groq,ollama

# LangSmith Observability & Tracing (optional, traces graph execution, nodes, and tool calls)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=repopilot

# Neural Cross-Encoder Reranking (optional, improves RAG precision at the cost of ~200-500ms CPU latency)
# Requires: sentence-transformers >= 2.2 (already installed)
# Model: cross-encoder/ms-marco-MiniLM-L-6-v2 (downloaded on first use, ~80 MB)
ENABLE_NEURAL_RERANKER=false

# Generator Evaluation Judge Configuration (evals/scripts/run_generator_eval.py only)
# The judge model MUST differ from the generator model (OLLAMA_MODEL / GEMINI_MODEL)
# to avoid self-preference bias. A different model family is ideal.
EVAL_JUDGE_PROVIDER=gemini
EVAL_JUDGE_MODEL=gemini-3.1-flash-lite
