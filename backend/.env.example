# RepoPilot — Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real configuration.

# PostgreSQL connection string with pgvector support
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/repopilot

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# GitHub Personal Access Token (optional, raises rate limit from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here

# Code Chunking Configuration
CHUNK_SIZE_TOKENS=250
CHUNK_OVERLAP_TOKENS=40
MAX_FILE_SIZE_KB=100
# Chunking strategy: 'ast' (Tree-sitter AST-aware chunking) or 'tokens' (sliding token window)
CHUNK_STRATEGY=ast

# Google Gemini API Key (cloud LLM fallback for codebase Q&A)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# LangGraph Agent Execution Limits
# Maximum supersteps (node transitions) allowed per chat turn before concluding (default: 50)
AGENT_RECURSION_LIMIT=50

# Optional: Local Ollama Configuration (defaults to http://localhost:11434 if unset)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest

# LangSmith Observability & Tracing (optional, traces graph execution, nodes, and tool calls)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=repopilot

# Neural Cross-Encoder Reranking (optional, improves RAG precision at the cost of ~200-500ms CPU latency)
# Requires: sentence-transformers >= 2.2 (already installed)
# Model: cross-encoder/ms-marco-MiniLM-L-6-v2 (downloaded on first use, ~80 MB)
ENABLE_NEURAL_RERANKER=false
